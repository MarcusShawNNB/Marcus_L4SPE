	column Project_Final =
			
			VAR _CurrentProject = 'Supporting_MEH % Complete_2026'[Project]
			VAR _CurrentActivity = 'Supporting_MEH % Complete_2026'[Activity Name]
			RETURN
			    IF(
			        NOT(ISBLANK(_CurrentProject)) && _CurrentProject <> "",
			        _CurrentProject,
			        CALCULATE(
			            FIRSTNONBLANK(Dim_ECS[final_project_name], 1),
			            FILTER(
			                ALL(Dim_ECS),
			                Dim_ECS[ECS Code] = _CurrentActivity &&
			                Dim_ECS[final_project_name] <> BLANK() &&
			                Dim_ECS[final_project_name] <> ""
			            )
			        )
			    )
		lineageTag: c16642bd-4965-4621-88d2-a6c8d210c6cc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

