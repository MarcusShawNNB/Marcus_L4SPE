	column 'Is Max Date' =
			
			VAR MaxDate =
			    CALCULATE (
			        MAX ( 'Fact_BL_Forecast_L5_daily_spread'[Baseline Month Year Date] ),
			        REMOVEFILTERS ( 'Fact_BL_Forecast_L5_daily_spread' )
			    )
			RETURN
			    'Fact_BL_Forecast_L5_daily_spread'[Baseline Month Year Date] = MaxDate
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 813706c2-8c7c-48c3-bd9d-16f8a10aa06b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

