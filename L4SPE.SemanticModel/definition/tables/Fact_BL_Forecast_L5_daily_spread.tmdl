	column Already_claimed = ```
			
			var ac = RELATED(Dim_ECS[latest install date]) 
			RETURN
			IF(ac>=Fact_BL_Forecast_L5_daily_spread[Remaining Early Start],TRUE(),FALSE())
			```
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 4882848c-7ab4-41ab-a304-c55d2e7a5ba3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Activity
		lineageTag: f0a4971c-15ba-4519-ab81-e300d0223eda
		summarizeBy: none
		isNameInferred
		sourceColumn: Fact_Forecast_Baseline[Activity]

		annotation SummarizationSetBy = Automatic

	partition Fact_BL_Forecast_L5_daily_spread = calculated
		mode: import
		source = ```
				
				
				VAR _FilteredECS =
				    SELECTCOLUMNS (
				        Dim_ECS,
				        "ECS Code", Dim_ECS[ECS Code],
				        "Activity_ID", Dim_ECS[P6_ID],
				        "Planning Commodity", Dim_ECS[Planning Commodity],
				        "DesignQuantity", Dim_ECS[DesignQuantity],
				        "Room", Dim_ECS[Room]
				    )
				
				VAR _ForecastSnapshots =
				    SUMMARIZE(
				        'Fact_Forecast_Baseline',
				        'Fact_Forecast_Baseline'[Baseline Month Year Date],
				        'Fact_Forecast_Baseline'[Activity],
				
				        "Remaining Early Start",
				            MIN('Fact_Forecast_Baseline'[early_start]),
				
				        "Remaining Early Finish",
				            MIN('Fact_Forecast_Baseline'[early_finish]),
				
				        "Remaining Hours",
				            MIN('Fact_Forecast_Baseline'[Data.Remaining Work])
				    )
				
				VAR _BaseTable =
				    GENERATE(
				        _FilteredECS,
				        FILTER(
				            _ForecastSnapshots,
				            [Activity] = [ECS Code]
				        )
				    )
				
				RETURN
				GENERATE (
				    _BaseTable,
				
				    VAR _Qty = [DesignQuantity]
				    VAR _Hrs = [Remaining Hours]
				    VAR _Start = [Remaining Early Start]
				     // VAR _Finish = [Remaining Early Finish]
				   
				        VAR _RawFinish = [Remaining Early Finish]
				VAR _Finish =
				    IF (
				        _RawFinish = TRUNC ( _RawFinish ),   -- true if time component is exactly 00:00:00
				        _RawFinish - 1,                       -- roll back to the previous day (i.e. Saturday)
				        _RawFinish
				    )
				
				    VAR _WorkingDays =
				        FILTER (
				            'Dim_Date',
				            'Dim_Date'[Date] >= _Start
				                && 'Dim_Date'[Date] <= _Finish
				                && 'Dim_Date'[WorkingDay] = 1
				        )
				
				    VAR _TotalWorkingDays =
				        COUNTROWS ( _WorkingDays )
				
				    VAR _QtyPerDay =
				        DIVIDE ( _Qty, _TotalWorkingDays )
				
				    VAR _HrsPerDay =
				        DIVIDE ( _Hrs, _TotalWorkingDays )
				
				    VAR _WeeklyBreakdown =
				        ADDCOLUMNS (
				            SUMMARIZE (
				                _WorkingDays,
				                'Dim_Date'[Adjusted_date],
				                'Dim_Date'[Week Ending],
				                'Dim_Date'[Week_Ending_Y_M]
				            ),
				            "Working Days in Week",
				                VAR _ThisWeek = [Week Ending]
				                RETURN
				                    COUNTROWS (
				                        FILTER (
				                            _WorkingDays,
				                            'Dim_Date'[Week Ending] = _ThisWeek
				                        )
				                    )
				        )
				
				    VAR _WeeklyWithMonthCount =
				        ADDCOLUMNS (
				            _WeeklyBreakdown,
				            "Weeks in Month",
				                VAR _CurrentMonth = [Week_Ending_Y_M]
				                RETURN
				                    COUNTROWS (
				                        FILTER (
				                            _WeeklyBreakdown,
				                            [Week_Ending_Y_M] = _CurrentMonth
				                        )
				                    )
				        )
				
				    RETURN
				        ADDCOLUMNS (
				            _WeeklyWithMonthCount,
				            "Total Working Days", _TotalWorkingDays,
				            "Hrs Per Day", _HrsPerDay,
				            "Qty Per Day", _QtyPerDay,
				            "Qty This Week", [Working Days in Week] * _QtyPerDay,
				            "Hrs This Week", [Working Days in Week] * _HrsPerDay
				        )
				)
				```

	annotation PBI_Id = a41aeadb43734d9397d64f5a52afb17b

