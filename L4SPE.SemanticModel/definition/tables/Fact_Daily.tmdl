	column 'Weekly % Complete' = ```
			
			VAR CurrentECS = fact_daily[ECS Code]
			VAR CurrentDate = fact_daily[Day]
			
			VAR Progress_Now = Fact_Daily[% Complete]
			
			VAR Baseline = 
			    RELATED(Dim_ECS[Current % Complete])
			
			RETURN
			    IF(Progress_Now - Baseline < 0, BLANK(), Progress_Now - Baseline)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8978880e-59ab-4601-b88c-b3dad49e17e0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Hours Earned' = ```
			
			    fact_daily[Weekly % Complete] * RELATED(Dim_ECS[Final_Hours])
			```
		formatString: 0.00
		lineageTag: 50907980-1d5f-4082-954d-79c76c3913f6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DateTime =
			
			VAR BaseDate = Fact_Daily[Day]   -- your date column
			VAR HourOffset = IF(fact_Daily[Shift] = "AM", 20, 8)  -- 8 AM or 8 PM
			RETURN
			    BaseDate + TIME(HourOffset, 0, 0)
		formatString: General Date
		lineageTag: 2259f2ac-74fd-431c-afcf-55dc101ad853
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Daily Hours Earned' = ```
			
			VAR CurrentECS = fact_daily[ECS Code]
			
			-- Find the 2 latest datetimes for this ECS Code
			VAR LatestDateTime =
			    CALCULATE(
			        MAX(Fact_Daily[Day]),
			        FILTER(ALL(fact_daily), fact_daily[ECS Code] = CurrentECS)
			    )
			
			VAR PreviousDateTime =
			    CALCULATE(
			        MAX(Fact_Daily[Day]),
			        FILTER(
			            ALL(fact_daily),
			            fact_daily[ECS Code] = CurrentECS &&
			            Fact_Daily[Day] < LatestDateTime
			        )
			    )
			
			-- Get hours at each of those 2 datetimes
			VAR LatestHours =
			    CALCULATE(
			        MAX(fact_daily[Hours Earned]),
			        FILTER(ALL(fact_daily), fact_daily[ECS Code] = CurrentECS && Fact_Daily[Day] = LatestDateTime)
			    )
			
			VAR PreviousHours =
			    CALCULATE(
			        MAX(fact_daily[Hours Earned]),
			        FILTER(ALL(fact_daily), fact_daily[ECS Code] = CurrentECS && Fact_Daily[Day] = PreviousDateTime)
			    )
			
			RETURN
			
			    IF (
			        Fact_Daily[Day] = LatestDateTime
			            && NOT ISBLANK ( PreviousHours ),
			        LatestHours - PreviousHours,
			        Fact_Daily[Hours Earned]
			    )
			
			```
		lineageTag: 50ad7ea8-93e2-475a-8eb5-29c325cb84b9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Reporting Week' = LOOKUPVALUE(Dim_Date[Week Ending],Dim_Date[Date],Fact_Daily[Day])
