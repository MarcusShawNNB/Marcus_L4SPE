	column Is_Latest_Record =
			
			VAR CurrentECS = fact_daily[ECS Code]
			VAR MaxDateTime =
			    CALCULATE (
			        MAX ( fact_daily[DateTime] ),
			        FILTER (
			            ALL ( fact_daily ),
			            fact_daily[ECS Code] = CurrentECS
			        )
			    )
			RETURN
			    fact_daily[DateTime] = MaxDateTime
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: f7c5665f-466c-41ba-bf6e-2aedc22b966d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'L6 Activity'
		dataType: string
		lineageTag: 4b059019-4ede-485c-a8d4-4a442b67a361
		summarizeBy: none
		sourceColumn: L6 Activity

		annotation SummarizationSetBy = Automatic

	partition Fact_Daily = m
		mode: import
		queryGroup: Actuals
		source =
				let
				    // --- Step 1: Get all Excel files from the SharePoint folder ---
				    Source = SharePoint.Files("https://edfenergynnb.sharepoint.com/sites/L4Analysts", [ApiVersion = 15]),
				
				    FilteredFolder = Table.SelectRows(
				        Source,
				        each Text.Contains([Folder Path], "Daily/Daily Progress")
				            and [Extension] = ".xlsx"
				            and not Text.Contains([Folder Path], "Archive")
				    ),
				
				    // --- Step 2: Read each Excel file into a table of sheets ---
				    GetSheets = Table.AddColumn(FilteredFolder, "ExcelData", each Excel.Workbook([Content], null, true)),
				
				    // --- Step 3: Rename sheet Name column to avoid conflict ---
				    RenamedSheets = Table.TransformColumns(
				        GetSheets,
				        {"ExcelData", each Table.RenameColumns(_, {{"Name", "SheetName"}}), type table}
				    ),
				
				    // --- Step 4: Expand all sheets ---
				    ExpandedSheets = Table.ExpandTableColumn(RenamedSheets, "ExcelData", {"SheetName", "Kind", "Data"}),
				
				    // --- Step 5: Keep only sheets named "id" ---
				    DailySheets = Table.SelectRows(ExpandedSheets, each [SheetName] = "id" and [Kind] = "Sheet"),
				
				    // --- Step 5b: Promote headers WITHIN each file's Data table individually ---
				    // This is the fix — headers get promoted per-file, before the files are combined,
				    // so each file's header row doesn't get carried through as a data row.
				    PromotedPerFile = Table.TransformColumns(
				        DailySheets,
				        {"Data", each Table.PromoteHeaders(_, [PromoteAllScalars = true]), type table}
				    ),
				
				    // --- Step 6: Expand all columns dynamically (headers already correct per file) ---
				    DailyData = Table.ExpandTableColumn(PromotedPerFile, "Data", Table.ColumnNames(PromotedPerFile{0}[Data])),
				
				    #"Removed Columns" = Table.RemoveColumns(
				        DailyData,
				        {
				            "Content", "Extension", "Date accessed", "Date modified",
				            "Date created", "Attributes", "Folder Path",
				            "SheetName", "Kind"
				        }
				    ),
				
				    // --- Force first column name to "File Name" (this is the file's [Name] column from SharePoint.Files) ---
				    #"Force First Column Name" =
				        Table.RenameColumns(
				            #"Removed Columns",
				            {
				                { Table.ColumnNames(#"Removed Columns"){0}, "File Name" }
				            }
				        ),
				
				    #"Changed Type" = Table.TransformColumnTypes(
				        #"Force First Column Name",
				        {
				            {"Project", type text}, {"Cut-Off Date", type date}, {"Sub-Area", type text},
				            {"ECS", type text},
				            {"Commodity", type text}, {"Rule Of Credit", type text}, {"Actual Start", type date},
				            {"Actual Finish", type date}, {"Status", type text},
				            {"Percentage Complete", Int64.Type}, {"Earned Hours", type number},
				            {"Comments", type text}
				        }
				    ),
				    #"Filtered Rows" = Table.SelectRows(#"Changed Type", each [ECS] <> null and [ECS] <> ""),
				
				    #"Added Extracted Date & Shift" =
				        Table.AddColumn(
				            #"Filtered Rows",
				            "Extracted Date & Shift",
				            each
				                let
				                    name = [File Name],
				                    cleaned = Text.BeforeDelimiter(name, ".xlsx"),
				                    removedProgress = Text.AfterDelimiter(cleaned, "Progress ", 0),
				
				                    Shift =
				                        if Text.EndsWith(removedProgress, " PM") then "AM"
				                        else "FullDay",
				
				                    ExtractedDateText = Text.Trim(Text.Replace(removedProgress, " PM", "")),
				                    ExtractedDateText2 = Text.Trim(Text.Replace(ExtractedDateText, " AM", "")),
				
				                    DayParts = Text.Split(ExtractedDateText2, "."),
				
				                    ExtractedDate =
				                        #date(
				                            2000 + Number.FromText(DayParts{2}),
				                            Number.FromText(DayParts{1}),
				                            Number.FromText(DayParts{0})
				                        )
				                in
				                    [Date = ExtractedDate, Shift = Shift],
				            type record
				        ),
				
				    #"Expanded Extracted Date & Shift" =
				        Table.ExpandRecordColumn(
				            #"Added Extracted Date & Shift",
				            "Extracted Date & Shift",
				            {"Date", "Shift"}
				        ),
				
				    #"Removed Columns1" =
				        Table.RemoveColumns(#"Expanded Extracted Date & Shift", {"Comments"}),
				
				    #"Inserted Division" =
				        Table.AddColumn(
				            #"Removed Columns1",
				            "Division",
				            each [Percentage Complete] / 100,
				            type number
				        ),
				
				    #"Changed Type1" =
				        Table.TransformColumnTypes(#"Inserted Division", {{"Division", Percentage.Type}}),
				
				    #"Removed Columns2" =
				        Table.RemoveColumns(
				            #"Changed Type1",
				            {
				                "Percentage Complete", "Sub-Area",
				                "Commodity", "Rule Of Credit",
				                "Actual Start", "Actual Finish", "Status",
				                "Cut-Off Date", "Project", "Earned Hours"
				            }
				        ),
				
				    #"Renamed Columns1" =
				        Table.RenameColumns(
				            #"Removed Columns2",
				            {{"Date", "Day"}, {"Division", "% Complete"}}
				        ),
				
				    #"Changed Type2" =
				        Table.TransformColumnTypes(#"Renamed Columns1", {{"Day", type date}}),
				
				    #"Renamed Columns2" =
				        Table.RenameColumns(#"Changed Type2", {{"ECS", "ECS Code"}}),
				
				    #"Added Custom" =
				        Table.AddColumn(
				            #"Renamed Columns2",
				            "Custom",
				            each
				                let
				                    Code = [#"ECS Code"],
				                    FixedSPL =
				                        if Text.EndsWith(Code, "SPL0") then Text.Replace(Code, "SPL0", "SPL00") else
				                        if Text.EndsWith(Code, "SPL1") then Text.Replace(Code, "SPL1", "SPL01") else
				                        if Text.EndsWith(Code, "SPL2") then Text.Replace(Code, "SPL2", "SPL02") else
				                        if Text.EndsWith(Code, "SPL3") then Text.Replace(Code, "SPL3", "SPL03") else
				                        if Text.EndsWith(Code, "SPL4") then Text.Replace(Code, "SPL4", "SPL04") else
				                        if Text.EndsWith(Code, "SPL5") then Text.Replace(Code, "SPL5", "SPL05") else
				                        if Text.EndsWith(Code, "SPL6") then Text.Replace(Code, "SPL6", "SPL06") else
				                        if Text.EndsWith(Code, "SPL7") then Text.Replace(Code, "SPL7", "SPL07") else
				                        if Text.EndsWith(Code, "SPL8") then Text.Replace(Code, "SPL8", "SPL08") else
				                        if Text.EndsWith(Code, "SPL9") then Text.Replace(Code, "SPL9", "SPL09") else
				                        Code,
				
				                    FinalCode =
				                        if Text.Contains(FixedSPL, "-SPL") then Text.Replace(FixedSPL, "-SPL", "SPL")
				                        else FixedSPL
				                in
				                    FinalCode
				        ),
				
				    #"Removed Columns3" =
				        Table.RemoveColumns(#"Added Custom", {"ECS Code"}),
				
				    #"Renamed Columns3" =
				        Table.RenameColumns(#"Removed Columns3", {{"Custom", "ECS Code"}}),
				
				    #"Replaced Value" =
				        Table.ReplaceValue(
				            #"Renamed Columns3",
				            "RYSPL",
				            "RY-SPL",
				            Replacer.ReplaceText,
				            {"ECS Code"}
				        ),
				
				    #"Max Date Check" =
				        let
				            MaxDate = List.Max(#"Replaced Value"[Day]),
				
				            MaxDateRows =
				                Table.SelectRows(
				                    #"Replaced Value",
				                    each [Day] = MaxDate
				                ),
				
				            PreferredShift =
				                if List.Contains(MaxDateRows[Shift], "FullDay") then
				                    "FullDay"
				                else if List.Contains(MaxDateRows[Shift], "PM") then
				                    "PM"
				                else
				                    "AM"
				        in
				            Table.AddColumn(
				                #"Replaced Value",
				                "Max Date Check",
				                each [Day] = MaxDate and [Shift] = PreferredShift,
				                type logical
				            )
				in
				    #"Max Date Check"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Exception

