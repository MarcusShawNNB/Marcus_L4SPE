	partition Fact_Forecast_Quantity_daily_spread = calculated
		mode: import
		source = ```
				
				 
				VAR _FilteredECS =
				    SELECTCOLUMNS(
				        FILTER(
				            'Dim_ECS',
				            ISBLANK( 'Dim_ECS'[actual_installed_date] )
				        ),
				        "ECS Code",             'Dim_ECS'[ECS Code],
				        "Activity_ID",          'Dim_ECS'[P6_ID],
				        "Planning Commodity",   'Dim_ECS'[Planning Commodity],
				        "DesignQuantity",       'Dim_ECS'[DesignQuantity],
				        "RemainingHours",       'Dim_ECS'[Remaining Hours],
				        "Total_Float",          'Dim_ECS'[Total Float]
				    )
				 
				VAR _BaseTable =
				    ADDCOLUMNS(
				        _FilteredECS,
				        "Remaining Early Start",
				            LOOKUPVALUE(
				                'Dim_Activity (LIVE_P6)'[Remaining Early Start],
				                'Dim_Activity (LIVE_P6)'[Activity ID], [Activity_ID]
				            ),
				        "Remaining Early Finish",
				            LOOKUPVALUE(
				                'Dim_Activity (LIVE_P6)'[Remaining Early Finish],
				                'Dim_Activity (LIVE_P6)'[Activity ID], [Activity_ID]
				            )
				    )
				 
				RETURN
				GENERATE(
				    _BaseTable,
				 
				    VAR _Qty        = [DesignQuantity]
				    VAR _rminghrs   = [RemainingHours]
				    VAR _Start      = [Remaining Early Start]
				   // VAR _Finish     = [Remaining Early Finish]
				    VAR _RawFinish = [Remaining Early Finish]
				VAR _Finish =
				    IF (
				        _RawFinish = TRUNC ( _RawFinish ),   -- true if time component is exactly 00:00:00
				        _RawFinish - 1,                       -- roll back to the previous day (i.e. Saturday)
				        _RawFinish
				    )
				 
				    VAR _WorkingDays =
				        FILTER(
				            'Dim_Date',
				            'Dim_Date'[Date] >= _Start
				                && 'Dim_Date'[Date] <= _Finish
				                && 'Dim_Date'[WorkingDay] = 1
				        )
				 
				    VAR _TotalWorkingDays = COUNTROWS( _WorkingDays )
				    VAR _QtyPerDay        = DIVIDE( _Qty, _TotalWorkingDays )
				    VAR _hrsperday        = DIVIDE( _rminghrs, _TotalWorkingDays )
				 
				    VAR _WeeklyBreakdown =
				        SUMMARIZE(
				            _WorkingDays,
				            'Dim_Date'[Week_Ending_Y_M],
				            'Dim_Date'[Week Ending],
				            "Working Days in Week",
				                COUNTROWS(
				                    FILTER(
				                        _WorkingDays,
				                        'Dim_Date'[Week Ending] = EARLIER('Dim_Date'[Week Ending])
				                    )
				                )
				        )
				 
				    -- For each weekly row, count how many distinct weeks share the same month
				    VAR _WeeklyWithMonthCount =
				        ADDCOLUMNS(
				            _WeeklyBreakdown,
				            "Weeks in Month",
				                COUNTROWS(
				                    FILTER(
				                        _WeeklyBreakdown,
				                        [Week_Ending_Y_M] = EARLIER( [Week_Ending_Y_M] )
				                    )
				                )
				        )
				 
				    RETURN
				    ADDCOLUMNS(
				        _WeeklyWithMonthCount,
				        "Total Quantity",       _Qty,
				        "Total Working Days",   _TotalWorkingDays,
				        "Qty Per Day",          _QtyPerDay,
				        "Hrs Per Day",          [Working Days in Week] * _hrsperday,      
				        "Qty This Week",        [Working Days in Week] * _QtyPerDay
				    )
				)
				 
				```

	annotation PBI_Id = ad73e86285d7459ebe23bc908b77d09d

