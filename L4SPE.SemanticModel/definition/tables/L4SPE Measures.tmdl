	/// created by marcus shaw | marcus.shaw@nnb-edfenergy.com
	measure cum_%_hours_earned = ```
			-- MS
			VAR _current_week = CALCULATE(MAX(Fact_Daily[Reporting Week]), ALL(Dim_Date))
			
			VAR _result = 
			    CALCULATE(
			        [%_hours_earned_to4],
			        FILTER(
			            ALLSELECTED(Dim_Date[Week Ending]),
			            ISONORAFTER(Dim_Date[Week Ending], MAX(Dim_Date[Week Ending]), DESC)
			        )
			    )
			
			RETURN
			IF(
			    MAX(Dim_Date[Week Ending]) <= _current_week,
			    _result,
			    BLANK()
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 3_Percent/Ratio
		lineageTag: 58c91446-bfcd-4c5f-9991-3c75d11c026f

