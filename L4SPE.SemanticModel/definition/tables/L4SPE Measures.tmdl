	measure '_DTS_FC 75%' = ```
			
			VAR Base =
			    SUMMARIZE(
			        FILTER(
			            Dim_ECS,
			            (
			                NOT ISBLANK(Dim_ECS[DTS FC]) 
			                || Dim_ECS[DTS Status] = "DELIVERED"
			            )
			        ),
			        Dim_ECS[ECS Code],
			        "FC_Date", MAX(Dim_ECS[DTS FC])
			    )
			
			VAR Pctl =
			    PERCENTILEX.INC(
			        Base,
			        VALUE([FC_Date]),
			        0.75
			    )
			
			RETURN
			DATE(1899,12,30) + Pctl
			```
