	/// created by marcus shaw | marcus.shaw@nnb-edfenergy.com
	measure %_delivered_rag =
			-- MS
			
			SWITCH(
			    TRUE(),
			    [%_delivered] < 0.2,  "#FF0000",  -- Red
			    [%_delivered] < 0.4,  "#FF4500",  -- Red-Amber
			    [%_delivered] < 0.6,  "#FFA500",  -- Amber
			    [%_delivered] < 0.8,  "#ADFF2F",  -- Amber-Green
			    "#00B050"                          -- Green
			)
		displayFolder: 3_Percent/Ratio
		lineageTag: d90de1f9-7440-4245-a703-9a817fa2d1fa

	/// created by marcus shaw | marcus.shaw@nnb-edfenergy.com
	measure %_Installed_rag =
			-- MS
			
			SWITCH(
			    TRUE(),
			    [%_installed] = BLANK() ,"#FFFFFF",
			    [%_installed] < 0.2,  "#FF0000",  -- Red
			    [%_installed] < 0.4,  "#FF4500",  -- Red-Amber
			    [%_installed] < 0.6,  "#FFA500",  -- Amber
			    [%_installed] < 0.8,  "#ADFF2F",  -- Amber-Green (Yellow-Green)
			    "#00B050"                          -- Green
			)
		displayFolder: 3_Percent/Ratio
		lineageTag: bfceb441-f83d-4799-ac9e-b99d1055d6ad

