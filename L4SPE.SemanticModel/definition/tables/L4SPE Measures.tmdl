	measure 'MultiDiscipline Room' =
			
			VAR DiscCount =
			    CALCULATE(
			        DISTINCTCOUNT('Dim_ECS'[Discipline]),
			        FILTER(
			            ALL('Dim_ECS'[Discipline]),
			            CALCULATE(SUM('Fact_BL_Forecast_L5_daily_spread'[Hrs This Week])) > 0
			        )
			    )
			RETURN
			IF(DiscCount > 1, 1, 0)
		formatString: 0
		displayFolder: 5_Helpers
		lineageTag: 2f525aa0-3ce8-47eb-9db7-dd790780121a

