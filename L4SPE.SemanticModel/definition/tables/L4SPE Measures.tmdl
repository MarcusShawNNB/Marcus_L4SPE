	/// created by marcus shaw | marcus.shaw@nnb-edfenergy.com
	measure cum_design_quantity_installed = ```
			
			VAR LastActualDate =
			    CALCULATE(
			        MAX(Dim_ECS[actual_installed_date]),
			        ALL(Dim_Date)          -- removes date filtering
			    )
			
			RETURN
			IF(
			    MAX(Dim_Date[Date]) <= LastActualDate,
			    CALCULATE(
			        [sum_design_quantity_actual_installed],
			        FILTER(
			            ALLSELECTED(Dim_Date[Date]),
			            Dim_Date[Date] <= MAX(Dim_Date[Date])
			        )
			    )
			)
			
			```
		formatString: 0.00
		displayFolder: 1_Quantities
		lineageTag: d64a54c8-f05a-4c5c-b478-7354f4810ee0

