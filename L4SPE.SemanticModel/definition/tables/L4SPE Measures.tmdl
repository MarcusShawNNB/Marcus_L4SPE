	/// created by marcus shaw | marcus.shaw@nnb-edfenergy.com
	measure cum_actual_hours_installed =
			-- MS
			
			VAR LastActualDate = MAX(Dim_ECS[actual_installed_date])
			RETURN
			IF(
			    MAX(Dim_Date[Date]) <= LastActualDate,
			    CALCULATE(
			        [sum_actual_hours_installed],
			        FILTER(
			            ALLSELECTED(Dim_Date[Date]),
			            Dim_Date[Date] <= MAX(Dim_Date[Date])
			        )
			    ),
			    BLANK()
			)
		displayFolder: 2_Hours
