	measure sum_design_quantity_actual_installed_inc_CMPIC =
			-- MS
			
			VAR CMPICStart = DATE(2026, 7, 27)
			
			VAR ECS_All =
			    CALCULATE(
			        SUM(Dim_ECS[DesignQuantity]),
			        USERELATIONSHIP(Dim_Date[Date], Dim_ECS[actual_installed_date]),
			        Dim_ECS[actual_installed_date] <> BLANK()
			    )
			
			VAR ECS_CablePullingFromCMPIC =
			    CALCULATE(
			        SUM(Dim_ECS[DesignQuantity]),
			        USERELATIONSHIP(Dim_Date[Date], Dim_ECS[actual_installed_date]),
			        KEEPFILTERS(Dim_ECS[Planning Commodity] = "Cable Pulling"),
			        KEEPFILTERS(Dim_ECS[actual_installed_date] >= CMPICStart)
			    )
			
			VAR CMPIC =
			    CALCULATE(
			        SUM(Fact_CMPIC[Fully/Part-Pulled Length]),
			        USERELATIONSHIP(Dim_Date[Date], Fact_CMPIC[Latest Installation Status Date]),
			        Fact_CMPIC[Latest Installation Status Date] >= CMPICStart,
			        TREATAS(VALUES(Dim_ECS[Planning Commodity]), Fact_CMPIC[Planning Commodity]),
			        TREATAS(VALUES(Dim_ECS[Adj_unit]), Fact_CMPIC[Unit])
			    )
			
			RETURN
			    ECS_All - ECS_CablePullingFromCMPIC + CMPIC
		displayFolder: 1_Quantities
		lineageTag: 43957a25-1be8-490d-a08d-0e2edbe36c71

		annotation PBI_FormatHint = {"isGeneralNumber":true}

