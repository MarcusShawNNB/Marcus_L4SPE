	measure 'Cumulative IN-PROGRESS (ROC <90%) (''PIN No. of ECS CODES)' =
			-- MS
			
			CALCULATE(
			    DISTINCTCOUNT(Fact_Daily[ECS Code]),
			    fact_daily[Weekly % Complete] <= 0.9,USERELATIONSHIP(Dim_Date[Date], Fact_Daily[Reporting Week]))
		formatString: #,0
		displayFolder: 4_Daily Progress
		lineageTag: 4f6450e0-1bed-4ead-acc4-d8c0a857fa2f

	/// created by marcus shaw | marcus.shaw@nnb-edfenergy.com
	measure 'Cumulative COMPLETED (ROC >90%) (''PIN No. of ECS CODES)' =
			-- MS
			
			CALCULATE(
			    DISTINCTCOUNT(Fact_Daily[ECS Code]),
			    fact_daily[Weekly % Complete] >= 0.9
			,USERELATIONSHIP(Dim_Date[Date], Fact_Daily[Reporting Week]))
		formatString: #,0
		displayFolder: 4_Daily Progress
		lineageTag: 2169b387-38e6-4cb5-aec0-2299bb8570ea

	/// created by marcus shaw | marcus.shaw@nnb-edfenergy.com
	measure 'Cumulative COMPLETE (ROC >90%) (Quants - METERS or NO.)' =
			-- MS
			VAR IsEquip =
			    CONTAINSSTRING(SELECTEDVALUE(Dim_ECS[Planning Commodity]), "equip")
			
			VAR BaseTable =
			    CALCULATETABLE(
			        SUMMARIZE(
			            Fact_Daily,
			            Fact_Daily[ECS Code],
			            "MaxWeekly", MAX(Fact_Daily[% Complete]),
			            "MaxBaseline", MAX(Fact_Daily[Baseline % Complete]),
			            "Qty", MAX(Fact_Daily[Design Quantity])
			        ),
			        USERELATIONSHIP(Dim_Date[Date], Fact_Daily[Reporting Week])
			    )
			
			RETURN
			SUMX(
			    BaseTable,
			    IF(
			        IsEquip,
			        IF([MaxWeekly] = 1 && [MaxBaseline] < 1, [Qty], BLANK()),
			        IF([MaxWeekly] >= 0.9 && [MaxBaseline] < 0.9, [Qty], BLANK())
			    )
			)
		displayFolder: 4_Daily Progress
		lineageTag: c5155bd8-5ba7-463f-af8a-20dfd0d076d4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// created by marcus shaw | marcus.shaw@nnb-edfenergy.com
	measure 'Cumulative IN-PROGRESS (ROC <90%) (Quants - METERS or NO.)' =
			-- MS
			
			CALCULATE(
			    sum(Fact_Daily[Design Quantity]),
			    fact_daily[Weekly % Complete] < 0.9
			,USERELATIONSHIP(Dim_Date[Date], Fact_Daily[Reporting Week]))
		formatString: #,0.00
		displayFolder: 4_Daily Progress
		lineageTag: efe3ddc8-82b0-4142-bde2-904c2fb9e9cf

