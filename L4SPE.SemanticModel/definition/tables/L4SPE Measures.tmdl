	measure allocated_l5_hours_by_trade_rolling = ```
			
			SUMX(
			    Dim_Resource_Profile,
			    VAR TradePercent = Dim_Resource_Profile[%]
			    
			    VAR TotalRemainingHours =
			        CALCULATE(
			            [sum_remaining_hours_l5rolling_by_day],
			            ALLEXCEPT(
			                Dim_Resource_Profile,
			                Dim_Resource_Profile[Planning Commodity]
			            )
			        )
			    
			    RETURN
			
			        [sum_remaining_hours_l5rolling_by_day] * TradePercent
			)
			```
		formatString: "£"#,0.###############;-"£"#,0.###############;"£"#,0.###############
		lineageTag: 06cd8cb2-3487-41a1-bd7d-c1d0dc448e90

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure dynamic_people_per_day_l5_rolling =
			
			DIVIDE(
			    [allocated_l5_hours_by_trade_rolling],
