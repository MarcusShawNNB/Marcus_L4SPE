	column 'Weekly % Complete' =
			
			CALCULATE(
			    MAX(Fact_Daily[% Complete]),
			    RELATEDTABLE(Fact_Daily)
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1baa7bc8-5a73-476b-ad62-77010a9f4ee5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'In Week % Complete' =
			
