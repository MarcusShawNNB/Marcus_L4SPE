	column 'DTS FC' =
			
			VAR eq = RELATED(Dim_Equipment[MAX_DTS_FC])
			VAR EPM = RELATED(Dim_MEH_ENG[Forecast Date])
			RETURN
			COALESCE(EPM,eq)
		lineageTag: d86e9a34-ebd5-4e0a-97c5-38239f790473
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'DTS Status' =
			
			VAR eq =
			    IF (
			        RELATED ( Dim_Equipment[MAX_DTS_Actual] ) <> BLANK (),
			        "DELIVERED"
			    )
			
			VAR EPM =
			    IF (
			        RELATED ( Dim_MEH_ENG[DTS] ) <> BLANK (),
			        "DELIVERED"
			    )
			
			VAR commodities =
			    IF (
			        Dim_ECS[Planning Commodity] IN {
			            "Cable Tray",
			            "CMSS",
			            "Clamps"
			        }
			        ||
			        CONTAINSSTRING ( Dim_ECS[Planning Commodity], "coat" ),
			        "DELIVERED"
			    )
			
			RETURN
			    COALESCE ( EPM, eq, commodities )
		lineageTag: cd13275d-f1b1-4b20-ac13-130f14df7009
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'release date' =
			
			VAR RoomHOC = RELATED(Dim_HOC[HOC Date])
			VAR PlanningCommodity = [Planning Commodity]
			VAR DTSStatus = [DTS Status]
			VAR CutoffDate = DATE(2026, 5, 1)
			
			-- Inlined DTS FC logic
			VAR DTSFC =
			        Dim_ECS[DTS FC]
			
			-- Inlined Room Handover FC logic
			VAR RoomHandoverFC =
			    LOOKUPVALUE(
			        'Dim_Activity (LIVE_P6)'[Finish],
			        'Dim_Activity (LIVE_P6)'[Activity ID],
			        Dim_ECS[Consolidated Handover Milestone]
			    )
			VAR Rule1 =
			    IF(
			        DTSStatus = "DELIVERED"
			            && NOT ISBLANK(RoomHOC),
			        RoomHOC
			    )
			
			VAR Rule2 =
			    IF(
			        PlanningCommodity = "CABLE TRAY"
			            && NOT ISBLANK(RoomHOC),
			        RoomHOC
			    )
			
			VAR Rule3 =
			    IF(
			        PlanningCommodity = "CABLE TRAY",
			        RoomHandoverFC
			    )
			
			VAR Rule4 =
			    IF(
			        DTSStatus = "DELIVERED"
			            && NOT ISBLANK(RoomHOC),
			        RoomHOC
			    )
			
			VAR Rule5 =
			    IF(
			        DTSStatus = "DELIVERED",
			        RoomHandoverFC
			    )
			
			VAR Rule6 = MAX(DTSFC, RoomHandoverFC)
			
			VAR Result = COALESCE(Rule1, Rule2, Rule3, Rule4, Rule5, Rule6)
			
			RETURN
			    DATE(YEAR(Result), MONTH(Result), DAY(Result))
		formatString: General Date
		lineageTag: 7cb765c2-10fd-4a51-b584-987d9c13e4d0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'HOC Date' = RELATED(Dim_HOC[HOC Date])
		formatString: General Date
		lineageTag: f5ea6ea7-f6aa-4e4f-afe7-08ddaa32f87a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'ROC Start Date' = ```
			
			// this is the date the ecs crossed the 90% progressed, and then how many days since that happened.
			// we need a second list to compare against, which is the re-work indicator list
			VAR First90_Prod  = CALCULATE(MIN(Fact_Production[Actuals Update]), Fact_Production[% Complete Capped] >= 0.9)
			VAR First90_Daily = CALCULATE(MIN(Fact_Daily[Day]),                Fact_Daily[Weekly % Complete] >= 0.9)
			
			// when we get the rework indiator
			// VAR Rework_Prod   = CALCULATE(MAX(Fact_Production[Actuals Update]), Fact_Production[Activity] = "I170")
			// VAR Rework_Daily  = CALCULATE(MAX(Fact_Daily[Day]),                Fact_Daily[Activity] = "I170")
			//VAR LastRework    = MAXX({Rework_Prod, Rework_Daily}, [Value])
			RETURN
			    MINX({First90_Prod, First90_Daily}, [Value])
			  //  MAXX({First90, LastRework}, [Value])   
			```
		formatString: Short Date
		lineageTag: fe44a24e-fa17-4510-bb54-d4718000085f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Days Remaining ROC' = ```
			
			VAR Start_ = Dim_ECS[ROC Start Date] 
			RETURN
			    IF( NOT ISBLANK( Start_ ), DATEDIFF( TODAY(), Start_ + 28, DAY ) )
			```
		formatString: 0
		lineageTag: 4beed4c3-c3bd-4069-a77f-fac844950b60
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

