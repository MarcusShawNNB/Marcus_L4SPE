	column 'Latest Baseline Planned Date' =
			
			VAR latest = MAX(Fact_Forecast_Baseline[Baseline Month Year])
			VAR Filteredbaseline = CALCULATETABLE(Fact_Forecast_Baseline,Fact_Forecast_Baseline[Baseline Month Year] = latest)
			VAR currentecs = Dim_ECS[ECS Code]
			RETURN
			
			CALCULATE(
			    MAX(Fact_Forecast_Baseline[Planned]),
			    Fact_Forecast_Baseline[Baseline Month Year] = latest,
			    Fact_Forecast_Baseline[ECS/Asset Code] = CurrentECS
			)
		formatString: General Date
		lineageTag: 9aa2eda7-899e-4f2e-bba8-b8bffb093626
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

