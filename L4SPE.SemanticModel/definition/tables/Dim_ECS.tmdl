	column 'LIVE - Forecast Finish Date' = ```
			
			    VAR FC =
			    LOOKUPVALUE(
			        'Dim_Activity (LIVE_P6)'[Remaining Early Finish],
			        'Dim_Activity (LIVE_P6)'[Activity ID], Dim_ECS[P6_ID]
			    )
			
			VAR AC =
			    Dim_ECS[actual_installed_date]
			
			RETURN
			IF(
			    NOT ISBLANK(AC),
			    AC,
			    FC
			)
			```
		formatString: Long Date
		lineageTag: 51c91ce3-cbcb-4712-ba69-eb89dc27bd68
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'IWS12 - FC Finish Date' = ```
			
			    VAR FC_1 =
			    LOOKUPVALUE(
			        'Dim_Activity (LIVE_P6)'[Remaining Early Finish],
			        'Dim_Activity (LIVE_P6)'[Activity ID], Dim_ECS[P6_ID]
			    )
			VAR FC_2 =
			    RELATED('Dim_P6_IWS12'[Remaining Early Finish])
			
			VAR AC =
			    Dim_ECS[actual_installed_date]
			
			RETURN
			IF(
			    NOT ISBLANK(AC),
			    AC,
			    FC_2
			)
			```
		formatString: General Date
		lineageTag: 1a2946f9-e5c4-424f-9d98-a071fb4df1c0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

