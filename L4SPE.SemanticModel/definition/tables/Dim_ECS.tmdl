	column actual_installed_date = ```
			
			VAR EquipmentThreshold = IF(SEARCH("equip", Dim_ECS[Planning Commodity], 1, 0) > 0, 1.0, 0.9)
			
			VAR FromProduction =
			    CALCULATE(
			        MIN(Fact_Production[Actuals Update]),
			        FILTER(
			            Fact_Production,
			            Fact_Production[ECS Code] = Dim_ECS[ECS Code] &&
			            Fact_Production[% Complete Capped] >= EquipmentThreshold
			        )
			    )
			
			// VAR FromDaily =
			//     CALCULATE(
			//         MIN(Fact_Daily[Day]),
			//         FILTER(
			//             Fact_Daily,
			//             Fact_Daily[ECS Code] = Dim_ECS[ECS Code] &&
			//             Dim_ECS[In Week % Complete] >= EquipmentThreshold
			//         )
			//     )
			
			RETURN
			FromProduction
			// IF(Dim_ECS[Old.ECS Code]<>BLANK(),Dim_ECS[Old.Actual Installed],FromProduction)
			
			```
		formatString: Short Date
		lineageTag: b53db566-836c-4de4-a631-5d0436a15460
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ScheduleActivity
		dataType: string
		lineageTag: 000bbc94-fd57-43ef-b5f6-d32ba67258aa
