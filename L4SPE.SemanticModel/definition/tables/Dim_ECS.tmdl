	column BoreSize =
			
			VAR Dia = Dim_ECS[Diameter]
			
			RETURN
			IF(
			    NOT ISBLANK(Dia) && Dia > 0,
			    SWITCH(
			        TRUE(),
			        Dia < 25,  "SR",
			        Dia <= 50,  "SB",
			        Dia <= 152, "MB",
			        Dia > 152,  "LB"
			    )
			)
		lineageTag: 82358f58-acff-4ccd-8114-22b9cd7cba4c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column P6_ID =
			
			RELATED (ECS_Assignments[Final_Activity_ID])
		lineageTag: e6399b49-5e0b-4449-a3f4-f2b9c40481fb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'latest install date' =
			
			VAR prev = CALCULATE(
			    MAX(Fact_Production[Actuals Update]),
			    RELATEDTABLE(Fact_Production)
			)
			VAR this_week = IF(Dim_ECS[In Week % Complete] > 0, MAX(Fact_Daily[Reporting Week]), BLANK())
			RETURN
			MAXX({prev, this_week}, [Value])
		formatString: General Date
		lineageTag: 94049361-c32d-4857-bdce-77b193912a50
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

