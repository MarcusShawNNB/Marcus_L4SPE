table 'Time Intel'
	lineageTag: 56542c46-6649-4fea-873c-6846f384872e

	calculationGroup

		calculationItem 'Time Intel' =
				CALCULATE(
				    SELECTEDMEASURE(),
				    FILTER(
				        ALLSELECTED(Dim_Date[Date]),
				        Dim_Date[Date]<= MAX(Dim_Date[Date])
				    )
				)

