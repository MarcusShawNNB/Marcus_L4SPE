	column 'Earned Hours Week_Actuals' =
			
			IF(
			    Fact_Production[Source] = "Actuals",
			    Fact_Production[Weekly % Delta] * RELATED(DIM_ECS[Final_Hours]),
			    BLANK()
			)
		lineageTag: 84e397b8-3ba5-4a65-82fd-1e0a64d33611
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

