	partition Fact_Production = m
		mode: import
		queryGroup: Actuals
		source =
				let
				    Production = Table.AddColumn(fact_production_, "Source", each "Production", type text),
				    Actuals = Table.AddColumn(fact_actuals, "Source", each "Actuals", type text),
				    Source = Table.Combine({Production, Actuals}),
				    #"Renamed Columns" = Table.RenameColumns(Source,{{"Update", "Actuals Update"}, {"% Complete", "% Complete Capped"}}),
				    #"Replaced Value" = Table.ReplaceValue(#"Renamed Columns","CLAMPS-SC","CLAMPS",Replacer.ReplaceText,{"ECS Code"}),
				    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value","CLAMPS-BC","CLAMPS",Replacer.ReplaceText,{"ECS Code"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Replaced Value1",{{"Actuals Update", type text}}),
				    #"Added Custom" = Table.AddColumn(#"Changed Type", "Custom", each [ECS Code]&[Actuals Update]),
				    #"Removed Duplicates" = Table.Distinct(#"Added Custom", {"Custom"}),
				    #"Removed Columns" = Table.RemoveColumns(#"Removed Duplicates",{"Custom"}),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Removed Columns",{{"Actuals Update", type date}}),
				    #"Appended Query" = Table.Combine({#"Changed Type1"}),
				    #"Split Column by Delimiter" = Table.SplitColumn(#"Appended Query", "ECS Code", Splitter.SplitTextByEachDelimiter({" "}, QuoteStyle.Csv, false), {"ECS Code.1", "ECS Code.2"}),
				    #"Removed Columns1" = Table.RemoveColumns(#"Split Column by Delimiter",{"ECS Code.2"}),
				    #"Renamed Columns1" = Table.RenameColumns(#"Removed Columns1",{{"ECS Code.1", "ECS Code"}}),
				    FilteredDaily = Table.SelectRows(Fact_Daily, each [Max Date Check] = true),
				    SelectColumns = Table.SelectColumns(FilteredDaily, {"% Complete", "ECS Code", "Day"}),
				    RenameDaily = Table.RenameColumns(SelectColumns, {{"% Complete", "% Complete Capped"}, {"Day", "Actuals Update"}}),
				    AddSource = Table.AddColumn(RenameDaily, "Source", each "Daily", type text),
				    FinalResult = Table.Combine({#"Renamed Columns1", AddSource})
				in
				    FinalResult

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Exception

