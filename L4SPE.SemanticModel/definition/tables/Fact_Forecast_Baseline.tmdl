	column last_progressed_date =
			
			CALCULATE(
			    MAX(Dim_ECS[latest install date]),
			    FILTER(
			        Dim_ECS,
			        Dim_ECS[Room] = 'Fact_Forecast_Baseline'[room]
			    )
			)
		formatString: General Date
		lineageTag: 8b8aabb7-904a-47e2-ac6d-d7ade01800cc
		summarizeBy: none

