	column 'Is Max Date' =
			
			VAR MaxDate =
			    CALCULATE (
			        MAX ( 'Fact_Forecast_Baseline'[Baseline Month Year Date] ),
			        REMOVEFILTERS ( 'Fact_Forecast_Baseline' )
			    )
			RETURN
			    'Fact_Forecast_Baseline'[Baseline Month Year Date] = MaxDate
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 100b6190-4d94-4f37-a4b5-88b075eb1d05
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

