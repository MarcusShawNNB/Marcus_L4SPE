		sourceColumn: YearMonth

		annotation SummarizationSetBy = Automatic

	column Week =
			
			VAR CurrentYear = YEAR(Dim_Date[Week Ending])
			VAR FirstDayOfYear = DATE(CurrentYear, 1, 1)
			VAR DaysSinceYearStart = Dim_Date[Week Ending] - FirstDayOfYear
			RETURN
			INT(DaysSinceYearStart / 7) + 1
		formatString: 0
		lineageTag: 9e3b4b40-7e20-428c-b9fb-0978e8817094
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Current Week' = ```
			
			 var latestreportingweek = MAX(Fact_Daily[Reporting Week])
			 RETURN
			 IF(Dim_Date[Week Ending]=latestreportingweek,TRUE, FALSE)
			```
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 896e148c-7a21-4733-97ae-83bf018593db
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column IsCurrentMonth =
			
			IF(
			    MONTH(Dim_Date[Adjusted_date]) = MONTH(TODAY()) &&
			    YEAR(Dim_Date[Adjusted_date]) = YEAR(TODAY()) ,
			    TRUE,
			    FALSE
			)
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 28e5fe55-256d-4fb3-aa64-cedf187cf797
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column IsYTD =
			
			VAR LastRefDate = MAX(Fact_Daily[Reporting Week])
			VAR NextSunday = LastRefDate + (7 - WEEKDAY(LastRefDate, 2))  // Next Sunday
			RETURN
			IF(
			    YEAR(Dim_Date[Adjusted_date]) = YEAR(LastRefDate) &&
			    Dim_Date[Adjusted_date] <= NextSunday,
			    TRUE(),
			    FALSE()
			)
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: b8153b47-327c-4da9-9105-fa23efe94817
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'last Week' =
			
			VAR latestreportingweek = MAX(Fact_Daily[Reporting Week]) - 7
			RETURN
			IF(Dim_Date[Week Ending] = latestreportingweek, TRUE, FALSE)
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 6bc4e373-8f4f-4b12-84cb-944dcc01c526
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Iscurrentyear =
			
			VAR LastRefDate = MAX(Fact_Daily[Reporting Week])
			VAR NextSunday = LastRefDate + (7 - WEEKDAY(LastRefDate, 2))  // Next Sunday
			RETURN
			IF(
			    YEAR(Dim_Date[Adjusted_date]) = YEAR(LastRefDate),
			    TRUE(),
			    FALSE()
			)
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 6102b1d6-18ca-444b-ae8b-97ba86ae39ea
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column WorkingDay =
			
			IF(
			    WEEKDAY(Dim_Date[Date], 2) <= 5,  -- 2 = Monday=1, Sunday=7
			    1,
			    0
			)
		formatString: 0
		lineageTag: 406912ff-5368-4ba8-8785-03da1711fda8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Year_Quarter =
			
			FORMAT(Dim_Date[Date], "YYYY") & " Q" & FORMAT(Dim_Date[Week Ending], "Q")
		lineageTag: 30e25a9b-a469-4ff5-a7bf-36c60e8853f2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

