	partition Dim_Date = m
		mode: import
		source =
				let
				    Source = #"Dim_Activity (LIVE_P6)",
				
				    MinDate = #date(2023, 1, 1),
				    MaxDate = #date(2029, 12, 31),
				    DateList = List.Dates(
				        MinDate,
				        Duration.Days(MaxDate - MinDate) + 1,
				        #duration(1, 0, 0, 0)
				    ),
				    ToTable = Table.FromList(DateList, Splitter.SplitByNothing(), {"Date"}),
				    ChangeType = Table.TransformColumnTypes(ToTable, {{"Date", type date}}),
				    AddWeekEnding = Table.AddColumn(ChangeType, "Week Ending", each Date.AddDays([Date], 6 - Number.Mod(Date.DayOfWeek([Date], Day.Monday), 7))),
				
				    #"Merged Queries" = Table.NestedJoin(
				        AddWeekEnding,
				        {"Date"},
				        AdjDates,
				        {"Dates"},
				        "AdjDates",
				        JoinKind.LeftOuter
				    ),
				    #"Expanded AdjDates" = Table.ExpandTableColumn(
				        #"Merged Queries",
				        "AdjDates",
				        {"Adj_Date"},
				        {"Adjusted_date"}
				    ),
				
				    #"Added Year" = Table.AddColumn(
				        #"Expanded AdjDates",
				        "Year",
				        each if [Adjusted_date] <> null then Date.Year([Adjusted_date]) else null,
				        Int64.Type
				    ),
				    #"Added Month" = Table.AddColumn(
				        #"Added Year",
				        "Month",
				        each if [Adjusted_date] <> null then Date.Month([Adjusted_date]) else null,
				        Int64.Type
				    ),
				    #"Added Month Name" = Table.AddColumn(
				        #"Added Month",
				        "Month Name",
				        each if [Adjusted_date] <> null then Date.ToText([Adjusted_date], "MMMM") else null,
				        type text
				    ),
				    #"Added YearMonth" = Table.AddColumn(
				        #"Added Month Name",
				        "YearMonth",
				        each if [Adjusted_date] <> null then Date.ToText([Adjusted_date], "yyyy-MM") else null,
				        type text
				    ),
				    #"Added Quarter" = Table.AddColumn(
				        #"Added YearMonth",
				        "Quarter",
				        each if [Adjusted_date] <> null then "Q" & Text.From(Date.QuarterOfYear([Adjusted_date])) else null,
				        type text
				    ),
				
				    #"Merged Queries1" = Table.NestedJoin(#"Added Quarter", {"Date"}, AdjDates, {"Dates"}, "AdjDates", JoinKind.LeftOuter),
				    #"Expanded AdjDates1" = Table.ExpandTableColumn(#"Merged Queries1", "AdjDates", {"Adj_Date"}, {"AdjDates.Adj_Date"}),
				    #"Removed Columns" = Table.RemoveColumns(#"Expanded AdjDates1", {"Adjusted_date"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns", {{"AdjDates.Adj_Date", "Adjusted_date"}}),
				
				    // Add Week_Ending_Y_M
				    #"Dim_Date_WithMonthCol" = Table.AddColumn(
				        #"Renamed Columns",
				        "Week_Ending_Y_M",
				        each Date.ToText([Week Ending], "MMM yyyy"),
				        type text
				    ),
				
				    // Add IsWorkingDay (weekday flag — adjust logic if you have a holiday calendar to exclude too)
				    #"Added IsWorkingDay" = Table.AddColumn(
				        #"Dim_Date_WithMonthCol",
				        "IsWorkingDay",
				        each if Date.DayOfWeek([Date], Day.Monday) < 5 then 1 else 0,
				        Int64.Type
				    )
				in
				    #"Added IsWorkingDay"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

