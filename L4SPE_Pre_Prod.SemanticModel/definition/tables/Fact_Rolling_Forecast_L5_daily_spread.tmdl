	partition Fact_Rolling_Forecast_L5_daily_spread = calculated
		mode: import
		source = ```
				
				
				
				
				
				VAR _FilteredECS =
				    SELECTCOLUMNS (
				        Dim_ECS,
				        "ECS Code", Dim_ECS[ECS Code],
				        "Activity_ID", Dim_ECS[P6_ID],
				        "Planning Commodity", Dim_ECS[Planning Commodity],
				        "DesignQuantity", Dim_ECS[DesignQuantity],
				        "Room", Dim_ECS[Room]
				    )
				
				VAR _ForecastSnapshots =
				    SUMMARIZE(
				        'Fact_Forecast_Rolling',
				        'Fact_Forecast_Rolling'[ECS/Asset Code], Fact_Forecast_Rolling[Week Published],
				
				        "Remaining Early Start",
				            MIN('Fact_Forecast_Rolling'[Early Start]),
				
				        "Remaining Early Finish",
				            MIN('Fact_Forecast_Rolling'[Early Finish]),
				
				        "Remaining Hours",
				            MIN('Fact_Forecast_Rolling'[Remaining Work])
				    )
				
				VAR _BaseTable =
				    GENERATE(
				        _FilteredECS,
				        FILTER(
				            _ForecastSnapshots,
				            [ECS/Asset Code] = [ECS Code]
				        )
				    )
				
				RETURN
				GENERATE (
				    _BaseTable,
				
				    VAR _Qty = [DesignQuantity]
				    VAR _Hrs = [Remaining Hours]
				    VAR _Start = [Remaining Early Start]
				   // VAR _Finish = [Remaining Early Finish]
				   
				        VAR _RawFinish = [Remaining Early Finish]
				VAR _Finish =
				    IF (
				        _RawFinish = TRUNC ( _RawFinish ),   -- true if time component is exactly 00:00:00
				        _RawFinish - 1,                       -- roll back to the previous day (i.e. Saturday)
				        _RawFinish
				    )
				
				    VAR _WorkingDays =
				        FILTER (
				            'Dim_Date',
				            'Dim_Date'[Date] >= _Start
				                && 'Dim_Date'[Date] <= _Finish
				                && 'Dim_Date'[WorkingDay] = 1
				        )
				
				    VAR _TotalWorkingDays =
				        COUNTROWS ( _WorkingDays )
				
				    VAR _QtyPerDay =
				        DIVIDE ( _Qty, _TotalWorkingDays )
				
				    VAR _HrsPerDay =
				        DIVIDE ( _Hrs, _TotalWorkingDays )
				
				    VAR _WeeklyBreakdown =
				        ADDCOLUMNS (
				            SUMMARIZE (
				                _WorkingDays,
				                'Dim_Date'[Adjusted_date],
				                'Dim_Date'[Week Ending],
				                'Dim_Date'[Week_Ending_Y_M]
				            ),
				            "Working Days in Week",
				                VAR _ThisWeek = [Week Ending]
				                RETURN
				                    COUNTROWS (
				                        FILTER (
				                            _WorkingDays,
				                            'Dim_Date'[Week Ending] = _ThisWeek
				                        )
				                    )
				        )
				
				    VAR _WeeklyWithMonthCount =
				        ADDCOLUMNS (
				            _WeeklyBreakdown,
				            "Weeks in Month",
				                VAR _CurrentMonth = [Week_Ending_Y_M]
				                RETURN
				                    COUNTROWS (
				                        FILTER (
				                            _WeeklyBreakdown,
				                            [Week_Ending_Y_M] = _CurrentMonth
				                        )
				                    )
				        )
				
				
				
				    RETURN
				        ADDCOLUMNS (
				            _WeeklyWithMonthCount,
				            "Total Working Days", _TotalWorkingDays,
				            "Hrs Per Day", _HrsPerDay,
				            "Qty Per Day", _QtyPerDay,
				            "Qty This Week", [Working Days in Week] * _QtyPerDay,
				            "Hrs This Week", [Working Days in Week] * _HrsPerDay
				        )
				)
				```

	annotation PBI_Id = e206ea7cd4e24f468444963bf166ff8f

