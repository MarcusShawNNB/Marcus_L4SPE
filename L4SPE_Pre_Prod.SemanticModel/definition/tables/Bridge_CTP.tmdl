	partition Bridge_CTP = calculated
		mode: import
		source =
				
				FILTER(
				    DISTINCT(
				        SELECTCOLUMNS(
				            Dim_ECS,
				            "CTP", Dim_ECS[CTP],
				            "ECS Code", Dim_ECS[ECS Code]
				           // "ECS_Key", Dim_ECS[Index]
				        )
				    ),
				    NOT ISBLANK([CTP]) &&
				    NOT ISBLANK([ECS Code])
				)

	annotation PBI_Id = a4800f75f88e4959832881c24f3bd619

