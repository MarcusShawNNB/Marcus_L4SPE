	column 'Booking Group' =
			
			VAR DelayDesc = TRIM([Delay Description])
			VAR DashPos = FIND("-", DelayDesc, 1, 0)
			
			VAR Result =
			    IF(
			        DashPos = 0,
			        DelayDesc,
			        TRIM(MID(DelayDesc, DashPos + 1, LEN(DelayDesc)))
			    )
			
			RETURN
			    SUBSTITUTE(Result, "Resource Delay", "Resource Delays")
		lineageTag: 97f962c1-c24c-451f-99fe-e4fda5464c14
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Commodity =
			
			VAR JobCode = Fact_Booked_Hours[Job Code]
			VAR Project = Fact_Booked_Hours[Project Adjusted]
			
			VAR Area =
			    MAXX(
			        FILTER(
			            Dim_ROOM,
			            Dim_ROOM[Final_Project_Name] = Project
			        ),
			        Dim_ROOM[Area]
			    )
			
			VAR MatchedCode =
			    MAXX(
			        FILTER(
			            'Commodity Mapping Table',
			            CONTAINSSTRING(
			                JobCode,
			                'Commodity Mapping Table'[Code - Booked Hours ]
			            )
			        ),
			        'Commodity Mapping Table'[Code - Booked Hours ]
			    )
			
			RETURN
			IF(
			CONTAINSSTRING(JobCode, "CLAMP"),
			"CLAMPS",
			        IF(
			            CONTAINSSTRING(JobCode, "MECH-PIPE") &&
			            ISBLANK(MatchedCode),
			            IF(
			                CONTAINSSTRING(Area, "BOP"),
			                "MECH-PIPE-BOP",
			                IF(
			                    CONTAINSSTRING(Area, "NI"),
			                    "MECH-PIPE-NI",
			                    "MECH-PIPE"
			                )
			            ),
			            MatchedCode
			        )
			    )
		lineageTag: 5a8bc29c-4c91-4e00-9d2f-00b76e1313f5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column area =
			CALCULATE(
			        MAX(Dim_ROOM[Area]),
			        FILTER(
			            Dim_ROOM,
			            Dim_ROOM[Final_Project_Name] = Fact_Booked_Hours[Project Adjusted]))
		lineageTag: b164ab8c-b7f2-4b41-988c-1eea5d72c811
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Is_Latest_Date =
			var maxdate = CALCULATE(MAX(Fact_Booked_Hours[Booking Date]),all(Fact_Booked_Hours)) RETURN
			Fact_Booked_Hours[Booking Date]=maxdate
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 539f8633-1849-45d6-894a-1f9f00ff0903
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Room =
			
			VAR DotPos = SEARCH(".", 'Fact_Booked_Hours'[Job Code], 1, 0)
			RETURN
			IF(
			    DotPos > 0,
			    LEFT('Fact_Booked_Hours'[Job Code], DotPos - 1),
			    'Fact_Booked_Hours'[Job Code]
			)
		lineageTag: 927b5701-c70e-4a91-8528-8b7524a2a39a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

