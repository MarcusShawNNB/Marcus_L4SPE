	partition Fact_Booked_Hours = m
		mode: import
		queryGroup: Actuals
		source = ```
				let
				    Source = PowerPlatform.Dataflows([]),
				    Workspaces = Source{[Id="Workspaces"]}[Data],
				    #"08b2498c-771b-444f-8d6c-866ef825ad96" = Workspaces{[workspaceId="08b2498c-771b-444f-8d6c-866ef825ad96"]}[Data],
				    #"e127115e-fce7-46b8-9d0d-1ed78fd62665" = #"08b2498c-771b-444f-8d6c-866ef825ad96"{[dataflowId="e127115e-fce7-46b8-9d0d-1ed78fd62665"]}[Data],
				    Fact_Booked_Hours_ = #"e127115e-fce7-46b8-9d0d-1ed78fd62665"{[entity="Fact_Booked_Hours",version=""]}[Data],
				
				    // Load the mapping table into a buffered list once, for performance
				    MappingTable = Table.Buffer(Dim_Job_Code_Category),
				
				    // Function: given a Job Code, find its matching row in the mapping table
				    MatchJobCode = (code as nullable text) as record =>
				        let
				            code_ = if code = null then "" else Text.Upper(Text.Trim(code)),
				            // 1. Try Exact match first
				            ExactMatch = Table.SelectRows(MappingTable, each 
				                [Match Type] = "Exact" and Text.Upper(Text.Trim([Job Code])) = code_
				            ),
				            // 2. Try Starts With (strip trailing * from pattern)
				            StartsWithMatch = Table.SelectRows(MappingTable, each
				                [Match Type] = "Starts With" and
				                Text.StartsWith(code_, Text.Upper(Text.Trim(Text.Replace([Job Code], "*", ""))))
				            ),
				            // 3. Try Contains (strip leading/trailing * from pattern)
				            ContainsMatch = Table.SelectRows(MappingTable, each
				                [Match Type] = "Contains" and
				                Text.Contains(code_, Text.Upper(Text.Trim(Text.Replace([Job Code], "*", ""))))
				            ),
				            Result =
				                if Table.RowCount(ExactMatch) > 0 then ExactMatch{0}
				                else if Table.RowCount(StartsWithMatch) > 0 then StartsWithMatch{0}
				                else if Table.RowCount(ContainsMatch) > 0 then ContainsMatch{0}
				                else [Category = "Uncategorised - " & code, CategoryGroup = "Uncategorised", RollupGroup = "Uncategorised"]
				        in
				            Result,
				
				    // Apply the match function to every row, returning a record column
				    #"Added Match Record" = Table.AddColumn(Fact_Booked_Hours_, "MatchResult", each MatchJobCode([Job Code])),
				
				    // Expand the record into three separate columns
				    #"Expanded Match" = Table.ExpandRecordColumn(#"Added Match Record", "MatchResult", 
				        {"Category", "CategoryGroup", "RollupGroup"}, 
				        {"Category", "CategoryGroup", "RollupGroup"}
				    )
				in
				    #"Expanded Match"
				```

