		    Production_Sheet = Source{[Item="Production",Kind="Sheet"]}[Data],
		    #"Promoted Headers" = Table.PromoteHeaders(Production_Sheet, [PromoteAllScalars=true]),
		    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"ECS Code", type text}, {"Installation % Complete", Percentage.Type}, {"Claimed At", type text}}),
		    #"Added Custom1" = Table.AddColumn(#"Changed Type", "Custom", each [ECS Code]&[Claimed At]),
		    #"Removed Duplicates" = Table.Distinct(#"Added Custom1", {"Custom"}),
		    #"Removed Columns3" = Table.RemoveColumns(#"Removed Duplicates",{"Custom"}),
		    #"Trimmed Text" = Table.TransformColumns(#"Removed Columns3",{{"ECS Code", Text.Trim, type text}}),
		    #"Removed Errors" = Table.RemoveRowsWithErrors(#"Trimmed Text", {"ECS Code"}),
		    #"Filtered Rows" = Table.SelectRows(#"Removed Errors", each [ECS Code] <> ""),
		    #"Changed Type2" = Table.TransformColumnTypes(#"Filtered Rows",{{"Installation % Complete", type number}}),
		    #"Renamed Columns" = Table.RenameColumns(#"Changed Type2",{{"Claimed At", "Last Actual Update"}}),
		    #"Changed Type3" = Table.TransformColumnTypes(#"Renamed Columns",{{"Last Actual Update", type date}}),
		    #"Sorted Rows1" = Table.Sort(#"Changed Type3",{{"Installation % Complete", Order.Descending}}),
		    #"Changed Type1" = Table.TransformColumnTypes(#"Sorted Rows1",{{"Installation % Complete", Percentage.Type}}),
		    #"Filtered Rows1" = Table.SelectRows(#"Changed Type1", each [ECS Code] <> ""),
		    #"Added Custom" = Table.AddColumn(#"Filtered Rows1", "Custom", each let
		    Code = [ECS Code],
		    FixedSPL = 
		        if Text.EndsWith(Code, "SPL0") then Text.Replace(Code, "SPL0", "SPL00") else
		        if Text.EndsWith(Code, "SPL1") then Text.Replace(Code, "SPL1", "SPL01") else
		        if Text.EndsWith(Code, "SPL2") then Text.Replace(Code, "SPL2", "SPL02") else
		        if Text.EndsWith(Code, "SPL3") then Text.Replace(Code, "SPL3", "SPL03") else
		        if Text.EndsWith(Code, "SPL4") then Text.Replace(Code, "SPL4", "SPL04") else
		        if Text.EndsWith(Code, "SPL5") then Text.Replace(Code, "SPL5", "SPL05") else
		        if Text.EndsWith(Code, "SPL6") then Text.Replace(Code, "SPL6", "SPL06") else
		        if Text.EndsWith(Code, "SPL7") then Text.Replace(Code, "SPL7", "SPL07") else
		        if Text.EndsWith(Code, "SPL8") then Text.Replace(Code, "SPL8", "SPL08") else
		        if Text.EndsWith(Code, "SPL9") then Text.Replace(Code, "SPL9", "SPL09") else
		        Code,
		    FinalCode = 
		        if Text.Contains(FixedSPL, "-SPL") then Text.Replace(FixedSPL, "-SPL", "SPL") 
		        else FixedSPL
		in
		    FinalCode),
		    #"Removed Columns" = Table.RemoveColumns(#"Added Custom",{"ECS Code"}),
		    #"Renamed Columns1" = Table.RenameColumns(#"Removed Columns",{{"Custom", "ECS Code"}}),
		    #"Added Conditional Column" = Table.AddColumn(#"Renamed Columns1", "% Complete Capped", each if [#"Installation % Complete"] > 1 then 1 else if [#"Installation % Complete"] <= 1 then [#"Installation % Complete"] else null),
		    #"Removed Columns1" = Table.RemoveColumns(#"Added Conditional Column",{"Installation % Complete"}),
		    #"Changed Type4" = Table.TransformColumnTypes(#"Removed Columns1",{{"% Complete Capped", Percentage.Type}}),
		    #"Removed Columns2" = Table.RemoveColumns(#"Changed Type4",{"Comment"}),
		    #"Reordered Columns" = Table.ReorderColumns(#"Removed Columns2",{"ECS Code", "Last Actual Update", "% Complete Capped"}),
		    #"Removed Errors1" = Table.RemoveRowsWithErrors(#"Reordered Columns", {"% Complete Capped"}),
		    #"Renamed Columns2" = Table.RenameColumns(#"Removed Errors1",{{"Last Actual Update", "Update"}, {"% Complete Capped", "% Complete"}}),
		    #"Replaced Value" = Table.ReplaceValue(#"Renamed Columns2","-SC","",Replacer.ReplaceText,{"ECS Code"}),
		    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value","-BC","",Replacer.ReplaceText,{"ECS Code"})
		in
		    #"Replaced Value1"
