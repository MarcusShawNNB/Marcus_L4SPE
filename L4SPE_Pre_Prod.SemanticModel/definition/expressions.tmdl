expression fact_actuals = ```
		let
		    Source = Excel.Workbook(
		        Web.Contents("https://edfenergynnb.sharepoint.com/sites/L4Analysts/Shared%20Documents/L4%20Analysts/00.%20Quantities/L4%20Schedule%20LIVE%20Dashboard%20-%20All%20Actuals.xlsx"), 
		        null, 
		        true
		    ),
		
		    #"All Actuals Live_Sheet" = Source{[Item="All Actuals Live",Kind="Sheet"]}[Data],
		
		    #"Promoted Headers" = Table.PromoteHeaders(#"All Actuals Live_Sheet", [PromoteAllScalars=true]),
		
		    #"Changed Type" = Table.TransformColumnTypes(
		        #"Promoted Headers",
		        {
		            {"ECS Code (1)", type text}, 
		            {"% Complete Claimed", type any}, 
		            {"Actual Date", type date}, 
		            {"Update from", type text}, 
		            {"Comments", type any}
		        }
		    ),
		
		    #"Grouped Rows" = Table.Group(
		        #"Changed Type", 
		        {"ECS Code (1)"}, 
		        {
		            {"AC_DATE", each List.Min([Actual Date]), type nullable date}, 
		            {"% Complete", each List.Max([#"% Complete Claimed"]), type number}
		        }
		    ),
		
		    #"Sorted Rows" = Table.Sort(#"Grouped Rows",{{"AC_DATE", Order.Descending}}),
		
		    #"Removed Duplicates" = Table.Distinct(#"Sorted Rows", {"ECS Code (1)"}),
		
		    #"Trimmed Text" = Table.TransformColumns(#"Removed Duplicates",{{"ECS Code (1)", Text.Trim, type text}}),
		
		    #"Removed Duplicates1" = Table.Distinct(#"Trimmed Text", {"ECS Code (1)"}),
		
		    #"Filtered Rows" = Table.SelectRows(#"Removed Duplicates1", each ([#"ECS Code (1)"] <> null)),
		
		    #"Renamed Columns" = Table.RenameColumns(#"Filtered Rows",{{"ECS Code (1)", "ECS Code"}}),
		
		    // --- ECS CLEANING LOGIC ---
		    #"Added Custom" = Table.AddColumn(
		        #"Renamed Columns", 
		        "ECS Code (1)", 
		        each 
		            let
		                Code = [ECS Code],
		                FixedSPL = 
		                    if Text.EndsWith(Code, "SPL0") then Text.Replace(Code, "SPL0", "SPL00") else
		                    if Text.EndsWith(Code, "SPL1") then Text.Replace(Code, "SPL1", "SPL01") else
		                    if Text.EndsWith(Code, "SPL2") then Text.Replace(Code, "SPL2", "SPL02") else
		                    if Text.EndsWith(Code, "SPL3") then Text.Replace(Code, "SPL3", "SPL03") else
		                    if Text.EndsWith(Code, "SPL4") then Text.Replace(Code, "SPL4", "SPL04") else
		                    if Text.EndsWith(Code, "SPL5") then Text.Replace(Code, "SPL5", "SPL05") else
		                    if Text.EndsWith(Code, "SPL6") then Text.Replace(Code, "SPL6", "SPL06") else
		                    if Text.EndsWith(Code, "SPL7") then Text.Replace(Code, "SPL7", "SPL07") else
		                    if Text.EndsWith(Code, "SPL8") then Text.Replace(Code, "SPL8", "SPL08") else
		                    if Text.EndsWith(Code, "SPL9") then Text.Replace(Code, "SPL9", "SPL09") else
		                    Code,
		
		                FinalCode = 
		                    if Text.Contains(FixedSPL, "-SPL") 
		                    then Text.Replace(FixedSPL, "-SPL", "SPL") 
		                    else FixedSPL
		            in
		                FinalCode,
		        type text
		    ),
		
		    #"Reordered Columns" = Table.ReorderColumns(
		        #"Added Custom",
		        {"ECS Code", "ECS Code (1)", "AC_DATE", "% Complete"}
		    ),
		
		    #"Sorted Rows1" = Table.Sort(#"Reordered Columns",{{"AC_DATE", Order.Ascending}}),
		
		    // ================================
		    // 🔥 INLINE UPDATE LOGIC STARTS HERE
		    // ================================
		
		   UpdateTable = #"Equipment List (update 24/03)",   // your second query (Install Dates)
		
		UpdateRecord = Record.FromTable(
		    Table.SelectColumns(
		        Table.RenameColumns(
		            UpdateTable,
		            {{"ECS", "Name"}, {"Install Date", "Value"}}
		        ),
		        {"Name", "Value"}
		    )
		),
		
		    // Replace AC_DATE using lookup
		   #"Updated AC_DATE" = Table.AddColumn(
		    #"Sorted Rows1",
		    "AC_DATE_New",
		    (row as record) =>
		        let
		            newDate = Record.FieldOrDefault(UpdateRecord, row[#"ECS Code (1)"], null)
		        in
		            if newDate <> null then newDate else row[AC_DATE],
		    type date
		),
		
		    #"Removed Old AC_DATE" = Table.RemoveColumns(#"Updated AC_DATE", {"AC_DATE"}),
		
		    #"Renamed New AC_DATE" = Table.RenameColumns(
		        #"Removed Old AC_DATE",
		        {{"AC_DATE_New", "AC_DATE"}}
		    ),
		
		    // ================================
		    // FINAL STEP
		    // ================================
		
		    #"Removed Duplicates2" = Table.Distinct(#"Renamed New AC_DATE", {"ECS Code (1)"}),
		    #"Removed Columns" = Table.RemoveColumns(#"Removed Duplicates2",{"ECS Code"}),
		    #"Renamed Columns1" = Table.RenameColumns(#"Removed Columns",{{"ECS Code (1)", "ECS Code"}, {"AC_DATE", "Update"}}),
		    #"Reordered Columns1" = Table.ReorderColumns(#"Renamed Columns1",{"ECS Code", "Update", "% Complete"}),
		    #"Changed Type1" = Table.TransformColumnTypes(#"Reordered Columns1",{{"% Complete", Percentage.Type}}),
		    #"Replaced Value" = Table.ReplaceValue(#"Changed Type1","-SC","",Replacer.ReplaceText,{"ECS Code"}),
		    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value","-BC","",Replacer.ReplaceText,{"ECS Code"})
		in
		    #"Replaced Value1"
		```
	lineageTag: ca581833-a0d9-451b-b352-9ab56caf9a45
	queryGroup: Actuals

